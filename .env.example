# ODR Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment environment.

# Backend server host and port
ODR_HOST=127.0.0.1
ODR_PORT=8000

# Storage directory for local projects, cache, and exports
ODR_DATA_DIR=data

# CORS allowed origins (comma-separated or * for local development)
ODR_CORS_ORIGINS=*
